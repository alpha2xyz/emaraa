# Server-side env vars (used by Express — loaded via --env-file=.env in dev, Vercel dashboard in prod)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service-role key — full DB access, bypasses RLS. REQUIRED in production. Server-only, NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
AUTHENTICA_API_KEY=your-authentica-api-key
# Public site URL — used to build email/CTA links. Defaults to https://emaraa.app if unset.
FRONTEND_URL=https://emaraa.app

# OTP test-mode login (local + preview ONLY) — lets specific FAKE phone numbers log in with a
# fixed code, skipping Authentica (no SMS sent, no credit spent). Also suppresses real outbound
# emails (logged as suppressed_test). MUST stay UNSET/inert in production — leaving OTP_TEST_MODE
# empty disables the whole bypass. Only the exact whitelisted numbers + exact code are ever affected.
OTP_TEST_MODE=
# Comma-separated list of fake test phone numbers allowed to bypass (e.g. 966500000001,966500000002)
OTP_TEST_NUMBERS=
# The fixed code those test numbers accept
OTP_TEST_CODE=

# Admin seed — on startup the server upserts an admin with these credentials (only re-hashes if
# the password changed). Leave both empty to skip seeding.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 1% commission bank-transfer details — shown in the "transfer the commission" email sent to the
# winning provider on offer accept. The whole commission email chain is DELIBERATELY INERT until
# COMMISSION_BANK_IBAN is set (empty IBAN = no commission emails, only the plain congrats email).
COMMISSION_BANK_NAME=
COMMISSION_BANK_ACCOUNT_NAME=
COMMISSION_BANK_IBAN=
# Hosted https PNG of the payment QR — NOT base64 (email clients strip data URIs)
COMMISSION_QR_URL=

# Client-side env vars (loaded by Vite — .env.local in dev, Vercel dashboard in prod)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Sentry error monitoring — leave EMPTY to keep Sentry fully disabled (no-op).
# Set these only when you want error tracking turned on.
SENTRY_DSN=
VITE_SENTRY_DSN=

# Zoho Mail SMTP — admin report emails
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
ADMIN_REPORT_TO=info@emaraa.app
CRON_SECRET=
