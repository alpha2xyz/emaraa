# .env.demo — the investor DEMO environment. Copy to .env.demo (gitignored) and fill.
#
# This file is deliberately SHORTER than .env.example. Every outbound channel is
# left empty on purpose: an empty credential is what makes the feature inert, and
# it is the only reliable way to guarantee a demo walkthrough cannot reach a real
# person. Do not "complete" this file by copying values over from .env.

# ── The demo Supabase project (NEVER the production ref txzbzpnrclkdodosbndy) ───
DEMO_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Login without SMS ──────────────────────────────────────────────────────────
# OTP_TEST_NUMBERS must list every phone number seeded by script/seed-demo.ts.
# server/app.ts refuses to start if OTP_TEST_MODE=true while SUPABASE_URL points
# at production, so this pair cannot leak onto the live site unnoticed.
OTP_TEST_MODE=true
OTP_TEST_CODE=1234
OTP_TEST_NUMBERS=0500000001,0500000002,0500000003,0500000004,0500000005,0500000011,0500000012,0500000013,0500000014,0500000015,0500000016,0500000017

# ── Shows the demo banner and the account switcher in the UI ───────────────────
VITE_DEMO_MODE=true

# ── DELIBERATELY EMPTY — do not fill these ─────────────────────────────────────
# Each one independently disables an outbound channel:
#   ZOHO_SMTP_*        server/email.ts returns "skipped_no_credentials" without
#                      opening SMTP. This is the ONLY thing that stops the
#                      new-request provider broadcast (server/outbox.ts) from
#                      emailing real providers — OTP_TEST_MODE does NOT cover it.
#   AUTHENTICA_API_KEY no SMS can be sent at all.
#   CRON_SECRET        every cron route rejects, so no scheduled email fires.
#   SLACK_...          no alerts leave the demo.
#   COMMISSION_BANK_*  the commission workflow stays dormant.
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
AUTHENTICA_API_KEY=
CRON_SECRET=
SLACK_BUSINESS_ALERTS_WEBHOOK_URL=
COMMISSION_BANK_IBAN=

# ── Admin, for seeding only. Not exposed in the demo UI. ───────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── E-signature — the one place in this file that IS meant to be filled ───────
# ESIGN_ENABLED=true is safe ONLY because SUPABASE_URL above points at the demo
# project, never production (server/app.ts's assertEsignIsNotOnProduction() boot
# guard refuses to start otherwise).
#
# ESIGN_VENDOR switches which vendor a NEW signature request goes to. Both vendors'
# credentials can sit here at once: flip the one line, accept an offer, and the deal
# is signed through the other vendor. Deals already in flight are unaffected — they
# keep using whatever created them (deals.signature_provider).
ESIGN_ENABLED=true
ESIGN_VENDOR=sadq

# Signit. ESIGN_VERIFICATION_METHOD=email, not nafath — Nafath issues a real digital
# certificate in a real person's name and cannot be exercised against the fictitious
# identities script/seed-demo.ts creates.
SIGNIT_CLIENT_ID=
SIGNIT_CLIENT_SECRET=
SIGNIT_API_BASE=https://api-sandbox.signit.sa/v1
ESIGN_VERIFICATION_METHOD=email

# SADQ. SADQ_AUTHENTICATION_TYPE=0 (no identity gate) for the same reason Signit uses
# email here: 1 is Nafath, and the seeded identities cannot verify as themselves.
SADQ_API_BASE=https://sandbox-api.sadq-sa.com
SADQ_ACCOUNT_ID=
SADQ_ACCOUNT_SECRET=
SADQ_USERNAME=
SADQ_PASSWORD=
SADQ_AUTHENTICATION_TYPE=0

# ── Demo access gate ──────────────────────────────────────────────────────────
# Replaces Vercel Authentication on the demo deployment: unlocked by the same admin
# username and password as /admin, and the cookie it issues expires one hour after login.
# DEMO_GATE_SECRET is any long random string, used only to sign that cookie.
DEMO_GATE_ENABLED=true
DEMO_GATE_SECRET=
